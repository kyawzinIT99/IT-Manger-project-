# ============================================================
# outputs.tf — Output Values (What Terraform Tells You After Deploy)
# ============================================================
# Outputs are like a "receipt" after Terraform finishes building.
# They show important information you need:
#   - URLs to access your services
#   - IP addresses to configure DNS
#   - Resource names for debugging
#
# Run 'terraform output' anytime to see these values again.
# ============================================================


# ========================
# CLOUD RUN
# ========================

output "cloud_run_url" {
  description = "Public URL of the Cloud Run storefront (auto-generated by Google)"
  value       = google_cloud_run_v2_service.storefront.uri
  # Example: "https://northpoint-storefront-dev-xxxxx-de.a.run.app"
  # Use this URL to test the store before setting up a custom domain.
}

output "cloud_run_service_name" {
  description = "Cloud Run service name (for gcloud commands)"
  value       = google_cloud_run_v2_service.storefront.name
  # Use in: gcloud run services describe <this-name> --region=asia-east2
}


# ========================
# CLOUD SQL
# ========================

output "cloud_sql_instance_name" {
  description = "Cloud SQL instance name (for gcloud commands and connection strings)"
  value       = google_sql_database_instance.primary.name
  # Use in: gcloud sql connect <this-name> --user=northpoint_app
}

output "cloud_sql_private_ip" {
  description = "Private IP of Cloud SQL (only accessible from within the VPC)"
  value       = google_sql_database_instance.primary.private_ip_address
  # This IP is used by Cloud Run to connect to the database.
  # It's a PRIVATE IP — not accessible from the internet.
}

output "cloud_sql_connection_name" {
  description = "Full connection name for Cloud SQL Proxy (project:region:instance)"
  value       = google_sql_database_instance.primary.connection_name
  # Format: "northpoint-living:asia-east2:northpoint-db-dev"
  # Used by Cloud SQL Proxy sidecar in Cloud Run
}

output "database_name" {
  description = "Database name inside the Cloud SQL instance"
  value       = google_sql_database.ecommerce.name
  # "northpoint" — the database our PHP app connects to
}


# ========================
# CLOUD STORAGE
# ========================

output "media_bucket_name" {
  description = "Cloud Storage bucket name for product media (images)"
  value       = google_storage_bucket.product_media.name
  # Use to upload images: gsutil cp image.jpg gs://<this-name>/products/
}

output "media_bucket_url" {
  description = "Public URL for accessing product media"
  value       = "https://storage.googleapis.com/${google_storage_bucket.product_media.name}"
  # Images accessible at: <this-url>/products/chair-001.jpg
}

output "backup_bucket_name" {
  description = "Cloud Storage bucket for database backups (in Singapore)"
  value       = google_storage_bucket.db_backups.name
  # Cross-region backup bucket — disaster recovery safety net
}


# ========================
# NETWORKING
# ========================

output "vpc_network_name" {
  description = "VPC network name"
  value       = google_compute_network.vpc.name
}

output "vpc_connector_name" {
  description = "Serverless VPC Connector name (connects Cloud Run to the VPC)"
  value       = google_vpc_access_connector.connector.name
}


# ========================
# CONTAINER REGISTRY
# ========================

output "docker_registry_url" {
  description = "Artifact Registry URL for pushing Docker images"
  value       = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker.repository_id}"
  # Push images with:
  # docker push <this-url>/storefront:latest
}


# ========================
# SERVICE ACCOUNTS
# ========================

output "cloud_run_service_account" {
  description = "Service account email used by Cloud Run"
  value       = google_service_account.cloud_run.email
}

output "cloud_build_service_account" {
  description = "Service account email used by Cloud Build CI/CD"
  value       = google_service_account.cloud_build.email
}


# ========================
# HELPFUL COMMANDS
# ========================

output "helpful_commands" {
  description = "Useful commands for managing the infrastructure"
  value = <<-EOT

    ╔══════════════════════════════════════════════════════════════╗
    ║              NORTHPOINT LIVING — USEFUL COMMANDS            ║
    ╠══════════════════════════════════════════════════════════════╣
    ║                                                              ║
    ║  📊 View Cloud Run logs:                                     ║
    ║  gcloud logging read "resource.type=cloud_run_revision"      ║
    ║    --project=${var.project_id} --limit=50                    ║
    ║                                                              ║
    ║  🔄 Deploy new version:                                      ║
    ║  gcloud run deploy ${google_cloud_run_v2_service.storefront.name}    ║
