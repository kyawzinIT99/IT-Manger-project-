    ║                                                              ║
    ║  ⏪ Rollback to previous version:                             ║
    ║  gcloud run services update-traffic                          ║
    ║    ${google_cloud_run_v2_service.storefront.name}            ║
    ║    --to-revisions=PREVIOUS=100 --region=${var.region}        ║
    ║                                                              ║
    ║  🗄️ Connect to database:                                     ║
    ║  gcloud sql connect ${google_sql_database_instance.primary.name}     ║
    ║    --user=northpoint_app                                     ║
    ║                                                              ║
    ║  📁 Upload product images:                                   ║
    ║  gsutil cp -r ./images/* gs://${google_storage_bucket.product_media.name}/  ║
    ║                                                              ║
    ║  💣 DESTROY all resources:                                   ║
    ║  terraform destroy                                           ║
    ║                                                              ║
    ╚══════════════════════════════════════════════════════════════╝
  EOT
}

